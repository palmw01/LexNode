  <data key="d25">['[[regels/AR-LI-9-1a]]']</data>
  <data key="d8">2026-01-01</data>
</node>
<node id="begrippen/vervaldag-eerste-termijn">
  <data key="d0">vervaldag-eerste-termijn</data>
  <data key="d1">begrip</data>
  <data key="d2">afleidingsregel</data>
  <data key="d3">#00B0F0</data>
  <data key="d10">vervaldag-eerste-termijn</data>
  <data key="d11">De eerste termijn vervalt één maand na de dagtekening van het aanslagbiljet</data>
  <data key="d12">Art. 9 lid 5 IW 1990</data>
  <data key="d13">['Art. 9 lid 5 IW 1990']</data>
  <data key="d6">2026-01-01</data>
  <data key="d14">grammaticaal</data>
  <data key="d15">Rekenregel die de vervaldatum van de eerste maandelijkse termijn bepaalt. Input: dagtekening aanslagbiljet. Output: vervaldatum = dagtekening + één maand.</data>
  <data key="d16">De rekenregel die de vervaldatum van de eerste gelijke invorderingstermijn vaststelt als het tijdstip gelegen één kalendermaand na de dagtekening van het aanslagbiljet</data>
  <data key="d17">datum</data>
  <data key="d18">afgeleid</data>

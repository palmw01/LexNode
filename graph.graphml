  <data key="d25">['[[regels/AR-9-5d]]']</data>
  <data key="d8">2026-01-01</data>
</node>
<node id="begrippen/voorlopige-aanslag">
  <data key="d0">voorlopige-aanslag</data>
  <data key="d1">begrip</data>
  <data key="d2">rechtsobject</data>
  <data key="d3">#70AD47</data>
  <data key="d10">voorlopige-aanslag</data>
  <data key="d11">voor voorlopige aanslagen (bedoeld in artikel 9, vijfde lid, van de wet)</data>
  <data key="d12">§ 9.1 LI 2008</data>
  <data key="d13">['Art. 9 lid 5 IW 1990', '§ 9.1 LI 2008']</data>
  <data key="d6">2026-01-01</data>
  <data key="d14">systematisch</data>
  <data key="d15">Rechtsobject dat het voorwerp is van de invorderingsregels in art. 9 IW 1990.</data>
  <data key="d16">Belastingaanslag die voorafgaand aan de definitieve vaststelling van de belastingschuld wordt opgelegd</data>
  <data key="d17">enumeratiewaarde [id]</data>
  <data key="d18">direct</data>
  <data key="d19">2026-01-01</data>
  <data key="d20"></data>
  <data key="d21">concept</data>
  <data key="d22">['[[begrippen/belastingaanslag]]']</data>

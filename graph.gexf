          <attvalue for="20" value="[]" />
          <attvalue for="21" value="['[[begrippen/maand-dagtekening-aanslagbiljet]]']" />
          <attvalue for="22" value="['[[begrippen/termijnenberekening-resterende-maanden]]']" />
          <attvalue for="23" value="['[[regels/AR-9-5b]]']" />
        </attvalues>
      </node>
      <node id="begrippen/telkens-een-maand-later" label="telkens-een-maand-later" start="2026-01-01">
        <attvalues>

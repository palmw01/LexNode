          <attvalue for="11" value="['§ 9.1 LI 2008']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="systematisch" />
          <attvalue for="13" value="Conditie gebaseerd op de uitkomst van de wettelijke termijnberekening." />
          <attvalue for="14" value="Situatie waarbij de berekende vervaldag van de laatste betalingstermijn volgens de regels van de wet valt op een datum vóór 31 december van het betreffende jaar" />

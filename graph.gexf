          <attvalue for="20" value="[]" />
          <attvalue for="21" value="['[[begrippen/maand-dagtekening-aanslagbiljet]]', '[[begrippen/resterende-maanden-jaar]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid-in-gelijke-termijnen]]']" />
          <attvalue for="23" value="['[[regels/AR-9-5b]]']" />
        </attvalues>
      </node>
      <node id="begrippen/terugvalregel-lid-1" label="terugvalregel-lid-1" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="afleidingsregel" />
          <attvalue for="2" value="#00B0F0" />
          <attvalue for="8" value="terugvalregel-lid-1" />
          <attvalue for="9" value="Indien de toepassing van de eerste volzin niet leidt tot meer dan één termijn, vindt het eerste lid toepassing." />
          <attvalue for="10" value="Art. 9 lid 5 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 5 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="systematisch" />
          <attvalue for="13" value="Beslissingsregel (terugvalregel) die de toepassingsgrens van de lid-5-termijnenregeling bepaalt. Als het berekende termijnenaantal ≤ 1 is, herneemt art. 9 lid 1 toepassing. Dit doet zich voor bij een dagtekening in december (0 resterende maanden na december)." />
          <attvalue for="14" value="De beslissingsregel die bepaalt dat art. 9 lid 1 IW 1990 herneemt als de termijnenberekening van art. 9 lid 5 eerste volzin niet leidt tot meer dan één termijn, zodat de zes-wekentermijn van lid 1 in de plaats treedt van de gelijke-termijnenregeling" />
          <attvalue for="15" value="waar-niet-waar" />
          <attvalue for="16" value="afgeleid" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="['[[begrippen/termijnenberekening-resterende-maanden]]', '[[begrippen/resterende-maanden-jaar]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid-belastingaanslag]]']" />
          <attvalue for="23" value="['[[regels/AR-9-5e]]']" />
        </attvalues>
      </node>
      <node id="begrippen/totaalbedrag-belastingaanslag" label="totaalbedrag-belastingaanslag" start="2026-01-01">

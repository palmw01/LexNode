      <node id="begrippen/termijnbedrag" label="termijnbedrag" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="variabele" />
          <attvalue for="2" value="#92D050" />
          <attvalue for="8" value="termijnbedrag" />

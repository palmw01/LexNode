      </node>
      <node id="begrippen/termijn-eindigt-voor-31-december" label="termijn-eindigt-voor-31-december" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="voorwaarde" />
          <attvalue for="2" value="#7030A0" />
          <attvalue for="8" value="termijn-eindigt-voor-31-december" />
          <attvalue for="9" value="toepassing van de wet er toe zou leiden dat de enige of laatste betalingstermijn eindigt voor 31 december" />

      <node id="begrippen/termijnenberekening-resterende-maanden" label="termijnenberekening-resterende-maanden" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="afleidingsregel" />
          <attvalue for="2" value="#00B0F0" />
          <attvalue for="8" value="termijnenberekening-resterende-maanden" />
          <attvalue for="9" value="in zoveel gelijke termijnen als er na de maand, die in de dagtekening van het aanslagbiljet is vermeld, nog maanden van het jaar overblijven" />
          <attvalue for="10" value="Art. 9 lid 5 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 5 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="systematisch" />
          <attvalue for="13" value="Rekenregel die het aantal invorderingstermijnen bepaalt. Input: maand van de dagtekening (tijdsaanduiding) en het resterende aantal kalendermaanden (variabele). Output: het exacte aantal gelijke maandelijkse termijnen. Logica: bij dagtekening in januari zijn er 11 termijnen; bij oktober 2, bij november 1 (terugval naar lid 1 via derde volzin)." />
          <attvalue for="14" value="De rekenregel die het aantal gelijke invorderingstermijnen bepaalt door het aantal kalendermaanden te tellen dat in het belastingjaar resteert na de maand die in de dagtekening van het aanslagbiljet is vermeld" />
          <attvalue for="15" value="getal" />
          <attvalue for="16" value="afgeleid" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />

          <attvalue for="11" value="['Art. 9 lid 5 IW 1990', '§ 9.1 LI 2008']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="systematisch" />
          <attvalue for="13" value="Rechtsobject dat het voorwerp is van de invorderingsregels in art. 9 IW 1990." />
          <attvalue for="14" value="Belastingaanslag die voorafgaand aan de definitieve vaststelling van de belastingschuld wordt opgelegd" />
          <attvalue for="15" value="enumeratiewaarde [id]" />

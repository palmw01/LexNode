          <attvalue for="22" value="[]" />
          <attvalue for="23" value="[]" />
        </attvalues>
      </node>
      <node id="begrippen/maand-dagtekening-aanslagbiljet" label="maand-dagtekening-aanslagbiljet" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="tijdsaanduiding" />
          <attvalue for="2" value="#F4B942" />
          <attvalue for="8" value="maand-dagtekening-aanslagbiljet" />
          <attvalue for="9" value="de maand, die in de dagtekening van het aanslagbiljet is vermeld" />
          <attvalue for="10" value="Art. 9 lid 5 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 5 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="grammaticaal" />
          <attvalue for="13" value="Tijdsaanduiding die de maandcomponent uit de dagtekening van het aanslagbiljet extraheert. Dit is het ankerpunt voor de termijnenberekening in lid 5: het aantal resterende maanden van het jaar wordt geteld na de vermelde maand." />
          <attvalue for="14" value="De kalendermaand die is vermeld in de dagtekening van het aanslagbiljet en die als referentiepunt dient voor de berekening van het aantal resterende maanden van het belastingjaar in de termijnenregeling van art. 9 lid 5 IW 1990" />
          <attvalue for="15" value="datum" />
          <attvalue for="16" value="direct" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />

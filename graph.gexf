          <attvalue for="21" value="[]" />
          <attvalue for="22" value="['[[begrippen/resterende-maanden-jaar]]']" />
          <attvalue for="23" value="[]" />
        </attvalues>
      </node>
      <node id="begrippen/resterende-maanden-jaar" label="resterende-maanden-jaar" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="variabele" />
          <attvalue for="2" value="#92D050" />
          <attvalue for="8" value="resterende-maanden-jaar" />
          <attvalue for="9" value="nog maanden van het jaar overblijven" />
          <attvalue for="10" value="Art. 9 lid 5 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 5 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="grammaticaal" />
          <attvalue for="13" value="Variabele die het aantal resterende kalendermaanden in het belastingjaar weergeeft, te tellen na de maand die in de dagtekening van het aanslagbiljet is vermeld. De waarde varieert naar gelang de dagtekening (max. 11 bij januari, min. 0 bij december)." />
          <attvalue for="14" value="Het aantal kalendermaanden dat in het belastingjaar resteert na de maand die in de dagtekening van het aanslagbiljet is vermeld, en dat gelijk is aan het aantal gelijke termijnen waarin de voorlopige aanslag invorderbaar is op grond van art. 9 lid 5 IW 1990" />
          <attvalue for="15" value="getal" />
          <attvalue for="16" value="afgeleid" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />

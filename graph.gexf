      <node id="begrippen/voorlopige-conserverende-aanslag-ib" label="voorlopige-conserverende-aanslag-ib" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="rechtsobject" />
          <attvalue for="2" value="#70AD47" />
          <attvalue for="8" value="voorlopige-conserverende-aanslag-ib" />
          <attvalue for="9" value="een voorlopige conserverende aanslag in de inkomstenbelasting" />
          <attvalue for="10" value="Art. 9 lid 5 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 5 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="grammaticaal" />
          <attvalue for="13" value="Naast de reguliere voorlopige aanslag IB/VPB benoemt lid 5 afzonderlijk de voorlopige conserverende aanslag IB als tweede aanslagtype waarvoor de termijnenregeling geldt. Het is een conserverende aanslag die belastinguitstel bij emigratie of vergelijkbare situaties beoogt te verzekeren." />
          <attvalue for="14" value="Een belastingaanslag in de inkomstenbelasting van voorlopige en conserverende aard, die — mits het aanslagbiljet is gedagtekend in het belastingjaar waarover hij is vastgesteld — invorderbaar is in gelijke maandelijkse termijnen overeenkomstig art. 9 lid 5 IW 1990" />
          <attvalue for="15" value="enumeratiewaarde" />
          <attvalue for="16" value="direct" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="['[[begrippen/belastingaanslag]]']" />
          <attvalue for="21" value="[]" />
          <attvalue for="22" value="[]" />
          <attvalue for="23" value="[]" />
        </attvalues>
      </node>
      <node id="begrippen/zes-weken-na-dagtekening-aanslagbiljet" label="zes-weken-na-dagtekening-aanslagbiljet" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="voorwaarde" />
          <attvalue for="2" value="#7030A0" />
          <attvalue for="8" value="zes-weken-na-dagtekening-aanslagbiljet" />
          <attvalue for="9" value="zes weken na de dagtekening van het aanslagbiljet" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 1 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="grammaticaal" />
          <attvalue for="13" value="De temporele zinsnede 'zes weken na de dagtekening van het aanslagbiljet' functioneert als de conditie waaraan voldaan moet zijn voor invorderbaarheid. De aanslag is pas invorderbaar nadat dit tijdvak is verstreken. De formulering bevat twee tijdsaanduidingen: de termijn ('zes weken') en het referentiepunt ('de dagtekening')." />
          <attvalue for="14" value="De tijdsconditie die vervuld moet zijn opdat een belastingaanslag invorderbaar wordt: het tijdstip van beoordeling moet zijn gelegen op of na het tijdstip dat resulteert uit het optellen van zes weken bij de dagtekening van het aanslagbiljet" />
          <attvalue for="15" value="datum" />
          <attvalue for="16" value="afgeleid" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="['[[begrippen/zes-weken]]', '[[begrippen/dagtekening-aanslagbiljet]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid]]']" />
          <attvalue for="23" value="['[[regels/AR-9-1]]']" />
        </attvalues>
      </node>
      <node id="begrippen/zes-weken" label="zes-weken" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="tijdsaanduiding" />
          <attvalue for="2" value="#F4B942" />
          <attvalue for="8" value="zes-weken" />
          <attvalue for="9" value="zes weken" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="11" value="['Art. 9 lid 1 IW 1990']" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="12" value="grammaticaal" />
          <attvalue for="13" value="De tijdsduur 'zes weken' is specifieker dan een variabele: het betreft een vaste termijn (tijdvak) die voor alle belastingaanslagen onder lid 1 gelijk is. Tijdsaanduiding heeft voorrang boven variabele en parameter (kaders §Meest specifieke klasse). Lid 10 bepaalt dat de Algemene termijnenwet niet van toepassing is, wat de berekening van deze termijn beïnvloedt." />
          <attvalue for="14" value="Een vaste termijn van zes aaneengesloten weken die als tijdvak geldt voor de berekening van het moment van invorderbaarheid van een belastingaanslag en die zonder verlenging voor weekenden of feestdagen wordt berekend" />
          <attvalue for="15" value="getal" />
          <attvalue for="16" value="direct" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="[]" />
          <attvalue for="22" value="[]" />
          <attvalue for="23" value="[]" />
        </attvalues>
      </node>
